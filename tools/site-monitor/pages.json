{
  "origin": "https://bolt.new",
  "core": [
    "/enterprise",
    "/get-started",
    "/solutions",
    "/solutions/ai-for-small-business",
    "/solutions/ai-for-entrepreneurs",
    "/solutions/ai-for-agencies",
    "/solutions/ai-for-real-estate",
    "/use-cases",
    "/platform/security",
    "/platform/features/cli",
    "/platform/integrations/microsoft",
    "/platform/referral",
    "/pricing",
    "/resources/templates",
    "/careers",
    "/customers",
    "/demo",
    "/news",
    "/blog"
  ],
  "rotating": {
    "comment": "The /use-cases/* slugs share one template, so each run audits a slice discovered from the /use-cases directory. The slice rotates by ISO week, so every slug is covered about every 10 weeks.",
    "indexPath": "/use-cases",
    "hrefPattern": "^/use-cases/[a-z0-9-]+$",
    "perRun": 8
  },
  "viewports": {
    "desktop": { "width": 1440, "height": 900 },
    "tablet": { "width": 834, "height": 1112 },
    "phone": { "width": 390, "height": 844, "isMobile": true, "hasTouch": true, "deviceScaleFactor": 3 }
  },
  "themes": ["light", "dark"]
}
